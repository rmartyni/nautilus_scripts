ORIGINALS_DIR="originals_jpg_$(date +%Y-%m-%d_%H%M)"
CONVERT="$(command -v magick || command -v convert)"

fail() {
    /usr/bin/notify-send "$@"
    exit 1
}

toJpg() {
    if [[ -z "$CONVERT" ]]; then
        fail "Missing ImageMagick (install imagemagick)"
    fi

    if [[ -e "$ORIGINALS_DIR" ]]; then
        fail "Folder already exists: $ORIGINALS_DIR"
    fi

    # Convert list to table
    mapfile -t FILES < <(printf '%s\n' "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS" | sed '/^$/d')

    # Check if we can create output files
    declare -A OUTPUTS
    for FPATH in "${FILES[@]}"; do
        FILE="${FPATH##*/}"
        NAME="${FILE%.*}"
        OUTPUT="${NAME}.jpg"
        if [[ -e "$OUTPUT" ]]; then
            fail "File already exists: $OUTPUT"
        fi
        if [[ -n "${OUTPUTS[$OUTPUT]}" ]]; then
            fail "Same output name for ${OUTPUTS[$OUTPUT]} and $FILE: $OUTPUT"
        fi
        OUTPUTS[$OUTPUT]="$FILE"
    done

    mkdir -p "$ORIGINALS_DIR"

    # Conversion to jpg
    for FPATH in "${FILES[@]}"; do
        FILE="${FPATH##*/}"
        NAME="${FILE%.*}"
        OUTPUT="${NAME}.jpg"

        if ! "$CONVERT" "$FILE" -background white -alpha remove -alpha off "$OUTPUT"; then
            fail "Failed converting: $FILE to $OUTPUT"
        fi
    done

    # Move original files
    for FPATH in "${FILES[@]}"; do
        FILE="${FPATH##*/}"
        mv "$FILE" "$ORIGINALS_DIR/"
    done
}

toJpg
